# =============================================================================
# 9th INTER IIIT SPORTS MEET 2026 - ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development.
# NEVER commit credentials, database connection strings, or production keys.

# PostgreSQL Connection String (Neon, Supabase, or standard PostgreSQL)
# Example Neon string: postgresql://username:password@ep-cool-lake-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inter_iiit

# Session Secret for signing/verifying HTTP-only session cookies
# Generate a random 32+ character string (e.g. openssl rand -base64 32)
SESSION_SECRET=super_secret_session_key_min_32_characters_long_inter_iiit_2026

# Admin initial seed password (used by src/db/seed.js)
ADMIN_PASSWORD=admin_sports_2026

# Default IIIT initial seed password prefix (used by src/db/seed.js)
DEFAULT_IIIT_PASSWORD=iiit_sports_2026

# Optional: Port configuration
PORT=3000
